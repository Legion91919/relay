  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Relay.Api/Relay.Api.csproj" />
    <ProjectReference Include="../../src/Modules/Identity/Relay.Identity.csproj" />
    <ProjectReference Include="../../src/Modules/Conversations/Relay.Conversations.csproj" />
    <ProjectReference Include="../../src/Modules/Delivery/Relay.Delivery.csproj" />
    <ProjectReference Include="../../src/Modules/Presence/Relay.Presence.csproj" />
  </ItemGroup>
</Project>
