# Relay API configuration (environment variables override appsettings.json).
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5103
# Base64 AES key (32 bytes) that encrypts held message bodies at rest. Required outside Development.
# Generate: openssl rand -base64 32
Delivery__ContentKey=
Delivery__Retention=30.00:00:00
Delivery__MaxBodyLength=2000
